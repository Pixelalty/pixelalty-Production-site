{
  "name": "pixelalty-sales",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.47.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.0.1",
    "playwright": "1.63.0",
    "prettier": "3.8.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  }
}
