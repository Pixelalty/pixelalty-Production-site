# Server-only bindings. Add secret values in Cloudflare, never in source control.
APP_URL=http://localhost:8787
# Hosted cutover: APP_URL=https://reps.pixelalty.com and RECRUITING_URL=https://join.pixelalty.com
RECRUITING_URL=
# Optional internal origin accepted only in test mode; never returned to the UI.
INTERNAL_APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Verified Pixelalty sender for activation/onboarding notifications.
EMAIL_FROM=Pixelalty Sales <sales@pixelalty.com>
RESEND_API_KEY=
