{
  "site_url": "https://reps.pixelalty.com",
  "uri_allow_list": "https://reps.pixelalty.com/,https://reps.pixelalty.com/welcome,https://reps.pixelalty.com/recover,https://reps.pixelalty.com/auth/confirm,https://reps.pixelalty.com/auth/callback",
  "smtp_sender_name": "Pixelalty Sales",
  "mailer_subjects_invite": "You’re invited to Pixelalty Sales",
  "mailer_templates_invite_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>You’re invited to Pixelalty Sales</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">You’re receiving this invitation because Pixelalty has approved your application or invited you to join our sales team.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Welcome to Pixelalty Sales</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">You’re receiving this invitation because Pixelalty has approved your application or invited you to join our sales team.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com/auth/confirm#token_hash={{ .TokenHash }}&amp;type=invite\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">SET UP YOUR PIXELALTY ACCOUNT</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">Create your password, then complete your profile, agreement and training. Your administrator will review your onboarding before activating your access to leads. This personal invitation can be used once.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_recovery": "Set up or reset your Pixelalty password",
  "mailer_templates_recovery_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Set up or reset your Pixelalty password</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">A secure password setup or reset was requested for your Pixelalty Sales account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Your next step starts here</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">A secure password setup or reset was requested for your Pixelalty Sales account.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com/auth/confirm#token_hash={{ .TokenHash }}&amp;type=recovery\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">CHOOSE YOUR PASSWORD</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">Choose a strong, unique password to return to your workspace or continue onboarding. If you didn’t request this, your current password stays unchanged and you can ignore this email.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_confirmation": "Confirm your Pixelalty email",
  "mailer_templates_confirmation_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Confirm your Pixelalty email</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">Confirm this email address to finish setting up your Pixelalty Sales account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Confirm your email address</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">Confirm this email address to finish setting up your Pixelalty Sales account.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com/auth/confirm#token_hash={{ .TokenHash }}&amp;type=email\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">CONFIRM MY EMAIL</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">After confirmation, sign in to complete the remaining steps in your onboarding checklist. This link is personal and can be used once.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Your secure Pixelalty sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Your secure Pixelalty sign-in link</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">Use your one-time link to securely open your Pixelalty Sales workspace.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Sign in to Pixelalty Sales</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">Use your one-time link to securely open your Pixelalty Sales workspace.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com/auth/confirm#token_hash={{ .TokenHash }}&amp;type=magiclink\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">SIGN IN TO PIXELALTY</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">If you didn’t request this sign-in link, you can ignore this email. Do not forward your link to anyone.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_email_change": "Confirm your Pixelalty email change",
  "mailer_templates_email_change_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Confirm your Pixelalty email change</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">A change to your Pixelalty Sales sign-in email was requested.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Confirm your email change</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">A change to your Pixelalty Sales sign-in email was requested.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com/auth/confirm#token_hash={{ .TokenHash }}&amp;type=email_change\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">CONFIRM EMAIL CHANGE</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">You may need to confirm using both your current and new inboxes. If you didn’t request this change, contact Pixelalty immediately.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_reauthentication": "Your Pixelalty verification code",
  "mailer_templates_reauthentication_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Your Pixelalty verification code</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">Use this one-time code to confirm the sensitive change you requested in Pixelalty Sales.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Verify it’s you</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">Use this one-time code to confirm the sensitive change you requested in Pixelalty Sales.</p>\n<p class=\"email-title\" style=\"font-size:30px;letter-spacing:8px;font-weight:bold;margin:28px 0\">{{ .Token }}</p>\n\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">Enter the code only in your Pixelalty workspace. Pixelalty will never ask you to send this code to another person.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Your Pixelalty password was changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>Your Pixelalty password was changed</title>\n<style>@media(prefers-color-scheme:dark){.email-bg{background:#101620!important}.email-card{background:#182130!important;color:#edf2fa!important}.email-muted{color:#aab8ce!important}.email-title{color:#edf2fa!important}.email-link{color:#a6c6ff!important}.email-card{border-color:#304159!important}}@media(max-width:600px){.email-content{padding:28px 22px!important}}</style></head>\n<body class=\"email-bg\" style=\"margin:0;padding:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#141c2b\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">The password for your Pixelalty Sales account was just changed.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:560px;border-collapse:separate\">\n<tr><td style=\"background:#111c2e;padding:28px 32px;border-radius:14px 14px 0 0;color:#fff\"><div style=\"font-size:23px;font-weight:800;letter-spacing:3px\">PIXELALTY</div><div style=\"font-size:10px;letter-spacing:3px;color:#b3c8ed;margin-top:8px\">PIXELALTY SALES</div></td></tr>\n<tr><td class=\"email-card email-content\" style=\"background:#fff;padding:38px 32px;border-radius:0 0 14px 14px;border:1px solid #dfe5ef;border-top:0\">\n<h1 class=\"email-title\" style=\"font-size:27px;line-height:1.3;margin:0 0 22px;color:#141c2b\">Your password is updated</h1>\n<p class=\"email-muted\" style=\"font-size:15px;line-height:1.7;color:#536276;margin:0 0 18px\">The password for your Pixelalty Sales account was just changed.</p>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0\"><tr><td bgcolor=\"#245dcc\" style=\"border-radius:8px\"><a href=\"https://reps.pixelalty.com\" style=\"display:inline-block;color:#fff;background:#245dcc;border:16px solid #245dcc;border-radius:8px;font-size:12px;line-height:1.6;font-weight:bold;letter-spacing:.5px;text-decoration:none\">OPEN PIXELALTY SALES</a></td></tr></table>\n<p class=\"email-muted\" style=\"font-size:14px;line-height:1.7;color:#536276;margin:0 0 24px\">If this was you, no action is needed. If you didn’t make this change, reset your password and contact Pixelalty immediately.</p>\n<p class=\"email-muted\" style=\"border-top:1px solid #dfe5ef;padding-top:22px;font-size:12px;line-height:1.7;color:#657184;margin:0\">Need help? <a class=\"email-link\" href=\"https://pixelalty.com/contact.html\" style=\"color:#245dcc\">Contact Pixelalty</a>. Never share your password or authentication code. If you weren’t expecting this email, contact us before continuing.</p>\n</td></tr><tr><td align=\"center\" class=\"email-muted\" style=\"padding:22px;font-size:11px;line-height:1.7;color:#657184\">Pixelalty Sales · Your sales workspace<br><a class=\"email-link\" href=\"https://pixelalty.com\" style=\"color:#657184;text-decoration:none\">pixelalty.com</a></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Your Pixelalty sign-in email was changed",
